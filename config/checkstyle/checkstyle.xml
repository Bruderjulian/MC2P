<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  MC2P Checkstyle rules.

  Formatting (indentation, wrapping, whitespace, brace placement) is enforced by
  Spotless with the Palantir Java Format profile; Checkstyle is limited to static
  lint rules a formatter cannot express. Keep this file aligned with that style
  (4-space indent, 120 columns).
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="LineLength">
        <property name="max" value="120"/>
        <!-- Palantir cannot split string literals; ignore any line carrying one. -->
        <property name="ignorePattern" value="^.*(\&quot;[^\&quot;]*\&quot;).*$"/>
    </module>

    <module name="TreeWalker">
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>

        <module name="EmptyBlock"/>
        <module name="NeedBraces"/>
    </module>
</module>